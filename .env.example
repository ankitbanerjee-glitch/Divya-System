PORT=3000
# MongoDB Atlas connection for this DIVYA project.
# Replace YOUR_URL_ENCODED_PASSWORD locally; never commit or share the real password.
MONGODB_URI=mongodb+srv://divya_app:YOUR_URL_ENCODED_PASSWORD@cluster0.06eyh9a.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=divya_system
# Set private, unique values before any shared or production deployment.
DIVYA_ADMIN_USER=choose_admin_username
DIVYA_ADMIN_PASSWORD=choose_a_long_random_admin_password
DIVYA_USER_USER=choose_monitoring_username
DIVYA_USER_PASSWORD=choose_a_long_random_monitoring_password
